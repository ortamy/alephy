{
  "schemaVersion": "1.0",
  "divisions": [
    {
      "id": "orchestration",
      "label": "Оркестрация",
      "color": "#b8860b",
      "agents": [
        "researcher",
        "collector",
        "flow-architect",
        "liaison"
      ],
      "description": "Организуют поток работы: извлекают тему, связывают контекст, сводят итог."
    },
    {
      "id": "research",
      "label": "Исследование",
      "color": "#2e7d32",
      "agents": [
        "researcher",
        "semitologist",
        "comparator",
        "paleo-translator"
      ],
      "description": "Извлекают термины, корни, семитские параллели и палео-образы."
    },
    {
      "id": "quality",
      "label": "Контроль качества",
      "color": "#c62828",
      "agents": [
        "exposer",
        "critic",
        "verifier"
      ],
      "description": "Ищут сдвиги, проверяют методологию и обязательные поля результата."
    },
    {
      "id": "documentation",
      "label": "Документация",
      "color": "#6a1b9a",
      "agents": [
        "editor",
        "collector",
        "technical-writer"
      ],
      "description": "Приводят черновик к стилю проекта, сводят результат, оформляют отчёт."
    },
    {
      "id": "code",
      "label": "Разработка",
      "color": "#1565c0",
      "agents": [
        "ai-engineer",
        "frontend-developer",
        "code-reviewer"
      ],
      "description": "Готовят задачи для LLM-инженера, аудитируют канон, ревьюют код."
    },
    {
      "id": "architecture",
      "label": "Архитектура",
      "color": "#006064",
      "agents": [
        "arch-scanner",
        "arch-critic",
        "arch-planner",
        "arch-writer",
        "arch-convergence"
      ],
      "description": "Снимают снимок репозитория, сверяют паспорт с диском, сводят цикл."
    }
  ],
